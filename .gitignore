# ---- C++ adapter ----
# Makefile output (one folder per compiler)
adapters/cpp/build/
adapters/cpp/rewriter/build/
# Stray binaries and objects from building by hand
*.o
*.out
*.dSYM/
# clangd index and generated compile database
.cache/
compile_commands.json

# ---- Generated traces ----
# Recorder output from local runs. Golden fixtures live in fixtures/ and stay tracked.
*.trace.json
!fixtures/*.trace.json
trace.json
*.json.tmp

# ---- Frontend (Goal 3) ----
# The generic node_modules/ and dist/ below already match these; listed so the frontend's are explicit.
frontend/node_modules/
frontend/dist/
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*

# ---- Python (validator, future adapter) ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- OS and editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~