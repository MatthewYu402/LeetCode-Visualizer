{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/trace.schema.json",
  "title": "Visualizer Trace",
  "description": "Language-neutral execution trace. Every adapter must emit output that validates against this schema. Spec: trace-format.md (v0.2).",
  "type": "object",
  "required": [
    "version",
    "language",
    "problem",
    "steps",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR trace format version."
    },
    "language": {
      "type": "string",
      "description": "Informational only. The frontend must not branch on this."
    },
    "problem": {
      "$ref": "#/$defs/problem"
    },
    "steps": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "truncated": {
      "type": "boolean",
      "description": "True if recording stopped at the step limit."
    },
    "result": {
      "$ref": "#/$defs/value"
    }
  },
  "$defs": {
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "value": {
      "description": "A primitive or a tagged object. The 'kind' field selects the renderer.",
      "oneOf": [
        {
          "$ref": "#/$defs/primitive"
        },
        {
          "$ref": "#/$defs/int"
        },
        {
          "$ref": "#/$defs/float"
        },
        {
          "$ref": "#/$defs/array"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/stack"
        },
        {
          "$ref": "#/$defs/queue"
        },
        {
          "$ref": "#/$defs/deque"
        },
        {
          "$ref": "#/$defs/heap"
        },
        {
          "$ref": "#/$defs/tuple"
        },
        {
          "$ref": "#/$defs/set"
        },
        {
          "$ref": "#/$defs/map"
        },
        {
          "$ref": "#/$defs/object"
        },
        {
          "$ref": "#/$defs/ref"
        }
      ]
    },
    "int": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "description": "Integer outside ±(2^53 − 1), which a JavaScript number cannot hold exactly. Digits in a string so JSON.parse cannot round them.",
      "properties": {
        "kind": {
          "const": "int"
        },
        "value": {
          "type": "string",
          "pattern": "^-?[1-9][0-9]{15,}$"
        }
      }
    },
    "float": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "description": "Non-finite float, which JSON has no syntax for. Finite floats are bare numbers.",
      "properties": {
        "kind": {
          "const": "float"
        },
        "value": {
          "enum": [
            "NaN",
            "Infinity",
            "-Infinity"
          ]
        }
      }
    },
    "array": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false,
      "description": "Random-access sequence: the next item is reached by offset (a[i]). vector, std::array, C arrays, Python list, Java arrays.",
      "properties": {
        "kind": {
          "const": "array"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "list": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false,
      "description": "Node-based sequence traversed by iterator, not by index: std::list, std::forward_list, Java LinkedList. items run front to back. Values only, no node identity; user-built ListNode chains are object + ref instead.",
      "properties": {
        "kind": {
          "const": "list"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false,
      "description": "items run bottom to top: the last item is the top.",
      "properties": {
        "kind": {
          "const": "stack"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false,
      "description": "items run front to back: the first item is the front.",
      "properties": {
        "kind": {
          "const": "queue"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "deque": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false,
      "description": "Double-ended queue. items run front to back.",
      "properties": {
        "kind": {
          "const": "deque"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "heap": {
      "type": "object",
      "required": [
        "kind",
        "items",
        "order"
      ],
      "additionalProperties": false,
      "description": "Priority queue. items are in storage (heap) order, not sorted. order says which end is on top.",
      "properties": {
        "kind": {
          "const": "heap"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "order": {
          "enum": [
            "max",
            "min",
            "custom"
          ],
          "description": "max: largest on top (std::less). min: smallest on top (std::greater). custom: any other comparator."
        }
      }
    },
    "tuple": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false,
      "description": "Fixed-size group that may mix types: pair, tuple.",
      "properties": {
        "kind": {
          "const": "tuple"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "set": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "map": {
      "type": "object",
      "required": [
        "kind",
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "map"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/value"
              },
              {
                "$ref": "#/$defs/value"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "object": {
      "type": "object",
      "required": [
        "kind",
        "type",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "object"
        },
        "type": {
          "type": "string",
          "description": "Neutral type name, e.g. TreeNode, ListNode."
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ref"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "step",
        "line",
        "locals",
        "heap"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line in the user's original source, about to execute."
        },
        "locals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "heap": {
          "type": "object",
          "description": "Objects referenced by 'ref' values, keyed by id.",
          "additionalProperties": {
            "$ref": "#/$defs/object"
          }
        }
      }
    },
    "hint": {
      "description": "How to draw a value whose kind alone is ambiguous. Inferred by the adapter, never supplied by the user.",
      "enum": [
        "grid",
        "adjacency-matrix",
        "adjacency-list",
        "edge-list",
        "intervals",
        "tree",
        "linked-list",
        "graph",
        "heap",
        "stack",
        "queue"
      ]
    },
    "problem": {
      "type": "object",
      "required": [
        "method",
        "params",
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Optional. A bare Solution class does not know which problem it solves."
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "Neutral type name such as array<int> or TreeNode, never a language type like vector<int>&.",
                "not": {
                  "pattern": "(std::|vector<|unordered_|[&*])"
                }
              },
              "hint": {
                "$ref": "#/$defs/hint"
              }
            }
          }
        },
        "input": {
          "type": "object"
        }
      }
    }
  }
}